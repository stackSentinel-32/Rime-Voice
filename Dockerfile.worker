# Agent worker image — full LiveKit/Rime/Deepgram/Gemini stack (heavier than backend).
FROM python:3.11-slim

WORKDIR /app

# silero VAD (onnxruntime) and av (PyAV) need OS libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# --retries/--timeout: PyPI from this network is flaky; fail only after real retries
RUN pip install --no-cache-dir --retries 10 --timeout 120 -r requirements.txt

COPY agent/ ./agent/
COPY backend/ ./backend/
COPY redis_state/ ./redis_state/

ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "agent.worker"]
