# ============================================================================
# Rime Voice Agent — environment template. Copy to .env and fill in.
# NEVER commit real credentials (code, docs, screenshots, or recordings).
# ============================================================================

# ---- LiveKit (transport / room / VAD) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ---- Rime TTS (REQUIRED) ----
# VERIFY every value below against the LIVE Rime catalog at build & submission
# time. Do not trust cached/example values — model/speaker names change.
RIME_API_KEY=your_rime_api_key
RIME_MODEL=mistv2          # <-- verify against live catalog
RIME_SPEAKER=cove          # <-- verify against live catalog
RIME_LANG=eng              # <-- verify against live catalog
RIME_AUDIO_FORMAT=pcm
RIME_SAMPLE_RATE=22050

# ---- STT ----
STT_PROVIDER=deepgram      # deepgram | whisper  (active provider is shown at /status)
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-2

# ---- LLM (tool-calling, OpenAI-compatible; env-switchable) ----
# Works with any OpenAI-compatible endpoint (OpenAI, Groq, DashScope, local).
# Confirm the model id is currently live before relying on it.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4o-mini

# ---- Infra ----
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg2://rime:rime@localhost:5432/rime
# Set USE_FAKE_REDIS=1 to force in-process fakeredis (used by the hermetic test).
# USE_FAKE_REDIS=1

# ---- Fault injection / thresholds (acceptance test) ----
TOOL_CALL_DELAY_MS=4000
INTERRUPT_AT_MS=1500
CANCEL_LATENCY_THRESHOLD_MS=300
