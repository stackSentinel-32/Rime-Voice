# ============================================================================
# Rime Voice Agent — environment template. Copy to .env and fill in.
# NEVER commit real credentials (code, docs, screenshots, or recordings).
# All values below are PLACEHOLDERS. Verified against live docs 2026-09-08 —
# re-verify at submission time with: python evidence/preflight.py
# ============================================================================

# ---- LiveKit (transport / room / VAD) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ---- Rime TTS (REQUIRED) ----
# Verified against docs.rime.ai 2026-09-08:
#   model  mistv3  — fastest current model (~37ms P50 TTFB); coda = flagship quality
#   speaker cove   — Mist v3-only voice (Female, young adult, African American);
#                    other confirmed starters: astra, luna (also on coda)
#   lang   en      — BCP-47 2-letter code (3-letter "eng" is legacy-compat only)
#   endpoint: wss://users-ws.rime.ai/ws3  (JSON streaming; Bearer auth header,
#             server-side only — browsers cannot set WS headers)
#   audio: audioFormat query param (wav|mp3|ogg|webm|pcm|mulaw), samplingRate
#          default 24000 Hz
RIME_API_KEY=your_rime_api_key
RIME_MODEL=mistv3
RIME_SPEAKER=cove
RIME_LANG=en
RIME_AUDIO_FORMAT=mp3
RIME_SAMPLING_RATE=24000

# ---- STT ----
STT_PROVIDER=deepgram      # deepgram | whisper  (active provider is shown at /status)
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-2

# ---- LLM: Google Gemini (tool-calling) ----
# Verified against ai.google.dev 2026-09-08: gemini-3.8-flash is GA and
# agent-tuned; gemini-2.5-flash is the classic low-latency fallback.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# ---- Infra ----
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg2://rime:rime@localhost:5432/rime
# Set USE_FAKE_REDIS=1 to force in-process fakeredis (used by the hermetic test).
# USE_FAKE_REDIS=1

# ---- Fault injection / thresholds (acceptance test) ----
TOOL_CALL_DELAY_MS=4000
INTERRUPT_AT_MS=1500
CANCEL_LATENCY_THRESHOLD_MS=300
